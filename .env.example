# ========================================
# TELEGRAM BOT НАСТРОЙКИ
# ========================================

# Токен вашего Telegram бота
# Получить можно у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ========================================
# АДМИНИСТРАТОРЫ
# ========================================

# Telegram ID администраторов (через запятую)
# Получить свой ID можно у бота @userinfobot
ADMIN_IDS=123456789

# ========================================
# ПРОВЕРКА ПОДПИСКИ НА КАНАЛ
# ========================================

# Username канала для проверки подписки
REQUIRED_CHANNEL=@your_channel

# ========================================
# RATE LIMITING
# ========================================

# Количество запросов на пользователя в час
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_HOURS=1

# ========================================
# ОГРАНИЧЕНИЯ ПАРСИНГА
# ========================================

# Максимальное количество отзывов/вопросов
MAX_REVIEWS=1000
MAX_QUESTIONS=1000

# ========================================
# НАСТРОЙКИ ПАРСЕРА
# ========================================

# Headless режим браузера (True/False)
PARSER_HEADLESS=True

# Timeout для парсера в миллисекундах
PARSER_TIMEOUT=60000

# ========================================
# SUPABASE (опционально)
# ========================================
# Если Supabase не настроен, будет использоваться локальная SQLite база
# ВАЖНО: Для Railway рекомендуется использовать Supabase,
# т.к. локальная БД не сохраняется при рестарте

# URL вашего Supabase проекта
# SUPABASE_URL=https://your-project.supabase.co

# Anon Key или Service Role Key
# SUPABASE_KEY=eyJ...
